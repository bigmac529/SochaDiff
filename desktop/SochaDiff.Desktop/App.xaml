<Application x:Class="SochaDiff.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <!-- Matches the web app's dark palette (public/styles.css). -->
    <SolidColorBrush x:Key="BgBrush" Color="#10151D" />
    <SolidColorBrush x:Key="PanelBrush" Color="#161B22" />
    <SolidColorBrush x:Key="BorderBrush" Color="#30363D" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6EDF3" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8B949E" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F85149" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2F81F7" />

    <Style x:Key="HostButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="#21262D" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#30363D" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
