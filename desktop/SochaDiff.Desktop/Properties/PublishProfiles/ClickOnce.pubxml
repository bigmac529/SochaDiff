<?xml version="1.0" encoding="utf-8"?>
<!--
  ClickOnce profile for https://sochadiff.socha3.com/ (NOT published yet).

  Publish from a Developer PowerShell (Visual Studio's MSBuild; `dotnet publish`
  does not support ClickOnce):
    pwsh desktop/scripts/prepare-bundle.ps1
    msbuild desktop/SochaDiff.Desktop/SochaDiff.Desktop.csproj /restore /t:Publish /p:PublishProfile=ClickOnce /p:ApplicationVersion=1.0.0.N
  then upload the contents of PublishDir (SochaDiff.application, setup.exe,
  Application Files/) to the site root.

  Self-contained: the .NET 8 Desktop Runtime ships inside the app, so users need no
  prerequisite (the Evergreen WebView2 Runtime is already part of Windows 11).
  Cost: roughly +70 MB compressed on first install; ClickOnce only downloads changed
  files on later updates, and runtime files change only when the runtime is serviced.

  TODO(signing): SignManifests/ManifestCertificateThumbprint stay unset until the
  code-signing certificate from Sissy Admin is available. Unsigned deployments show
  "Unknown publisher" and SmartScreen prompts.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>

    <PublishProtocol>ClickOnce</PublishProtocol>
    <PublishDir>bin\publish\clickonce\</PublishDir>
    <PublishUrl>bin\publish\clickonce\</PublishUrl>
    <InstallUrl>https://sochadiff.socha3.com/</InstallUrl>
    <InstallFrom>Web</InstallFrom>
    <Install>true</Install>
    <GenerateManifests>true</GenerateManifests>
    <MapFileExtensions>true</MapFileExtensions>
    <CreateWebPageOnPublish>false</CreateWebPageOnPublish>
    <OpenBrowserOnPublish>false</OpenBrowserOnPublish>
    <!-- setup.exe is the reliable entry point (Edge does not launch .application links by default). -->
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <IsWebBootstrapper>true</IsWebBootstrapper>

    <ApplicationVersion>1.0.0.0</ApplicationVersion>
    <ApplicationRevision>0</ApplicationRevision>
    <IsRevisionIncremented>true</IsRevisionIncremented>

    <!-- Check for updates before the app starts (skipped silently when offline). -->
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateRequired>false</UpdateRequired>

    <ProductName>Socha Diff</ProductName>
    <PublisherName>Socha3</PublisherName>
    <SuiteName>Socha3</SuiteName>
    <CreateDesktopShortcut>true</CreateDesktopShortcut>

    <!-- TODO(signing): certificate comes from Sissy Admin. Then set:
         <SignManifests>true</SignManifests>
         <ManifestCertificateThumbprint>...</ManifestCertificateThumbprint>
         <ManifestTimestampRFC3161Url>...</ManifestTimestampRFC3161Url> -->
    <SignManifests>false</SignManifests>
    <SignatureAlgorithm>(None)</SignatureAlgorithm>
    <SkipPublishVerification>false</SkipPublishVerification>
  </PropertyGroup>
</Project>
