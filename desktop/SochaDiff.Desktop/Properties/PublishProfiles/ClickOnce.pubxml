<?xml version="1.0" encoding="utf-8"?>
<!--
  ClickOnce profile for https://sochadiff.socha3.com/.

  Normal route: .github/workflows/publish-desktop.yml publishes on every merge to main.
  Manual route (Developer PowerShell, Visual Studio's MSBuild; `dotnet publish` does not
  support ClickOnce):
    pwsh desktop/scripts/publish-site.ps1 -Build <N>     (or -Version a.b.c.d)
  which runs prepare-bundle, then
    msbuild desktop/SochaDiff.Desktop/SochaDiff.Desktop.csproj /restore /t:Publish /p:PublishProfile=ClickOnce /p:SochaBuildNumber=N
  and assembles desktop/out/site/ (ClickOnce files + the download site) for the IIS root.

  FRAMEWORK-DEPENDENT: the .NET 10 Desktop Runtime (x64), the WebView2 Runtime and Node.js 20+
  are prerequisites installed once, separately (listed on the download page). The app payload
  itself is only the host + the web app (~6 MB instead of ~240 MB self-contained).

  Version: ApplicationVersion = <major>.<minor>.<SochaBuildNumber>.0 (major/minor from
  desktop/version.json, computed in the csproj). MinimumRequiredVersion = ApplicationVersion
  and UpdateMode=Foreground: every launch checks the site first and installs a newer version
  before starting, without offering "Skip" (offline launches still start the installed version).

  Signing: publish-site.ps1 -CertificateThumbprint or -PfxPath (CI: secrets SIGNING_PFX_BASE64 /
  SIGNING_PFX_PASSWORD, the self-signed CN=Socha3 certificate, thumbprint
  CF4137053F371F439BD420B02A51192C5DED6075). Every release must use the same certificate, or
  installed clients cannot update. Without it the build is unsigned ("Unknown publisher").
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>

    <PublishProtocol>ClickOnce</PublishProtocol>
    <PublishDir>bin\publish\clickonce\</PublishDir>
    <PublishUrl>bin\publish\clickonce\</PublishUrl>
    <InstallUrl>https://sochadiff.socha3.com/</InstallUrl>
    <InstallFrom>Web</InstallFrom>
    <Install>true</Install>
    <GenerateManifests>true</GenerateManifests>
    <MapFileExtensions>true</MapFileExtensions>
    <CreateWebPageOnPublish>false</CreateWebPageOnPublish>
    <OpenBrowserOnPublish>false</OpenBrowserOnPublish>
    <!-- setup.exe is the reliable entry point (Edge does not launch .application links by default)
         and installs missing prerequisites (below) before the app. -->
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <IsWebBootstrapper>true</IsWebBootstrapper>
    <!-- Prerequisites are downloaded from the vendors' sites, never bundled
         (BootstrapperComponentsLocation unset = "HomeSite"). -->

    <ApplicationVersion>$(SochaApplicationVersion)</ApplicationVersion>
    <ApplicationRevision>0</ApplicationRevision>
    <IsRevisionIncremented>false</IsRevisionIncremented>

    <!-- Check for updates before the app starts; every published version is required. -->
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateRequired>true</UpdateRequired>
    <MinimumRequiredVersion>$(ApplicationVersion)</MinimumRequiredVersion>

    <ProductName>Socha Diff</ProductName>
    <PublisherName>Socha3</PublisherName>
    <SuiteName>Socha3</SuiteName>
    <SupportUrl>https://sochadiff.socha3.com/</SupportUrl>
    <CreateDesktopShortcut>true</CreateDesktopShortcut>

    <!-- Off here; publish-site.ps1 passes SignManifests=true, ManifestCertificateThumbprint and
         ManifestTimestampUrl on the command line (global properties override this profile). -->
    <SignManifests>false</SignManifests>
    <SkipPublishVerification>false</SkipPublishVerification>
  </PropertyGroup>

  <!--
    setup.exe prerequisites. publish-site.ps1 sets SochaPrereqDotNet / SochaPrereqWebView2 to
    false when the bootstrapper package is not installed on the publishing machine, so a missing
    package only drops it from setup.exe (the website's prerequisite list and the in-app checks
    still cover it).
    - Microsoft.NetCore.DesktopRuntime.10.0.x64: ships with Visual Studio 2026's ClickOnce
      components (<VS>\MSBuild\Microsoft\VisualStudio\BootstrapperPackages).
    - Socha3.WebView2Runtime.Evergreen: custom package in desktop/bootstrapper/ (VS has none);
      publish-site.ps1 -InstallBootstrapperPackages installs it.
  -->
  <ItemGroup>
    <BootstrapperPackage Include="Microsoft.NetCore.DesktopRuntime.10.0.x64" Condition="'$(SochaPrereqDotNet)' != 'false'">
      <Install>true</Install>
      <ProductName>.NET Desktop Runtime 10.0 (x64)</ProductName>
    </BootstrapperPackage>
    <BootstrapperPackage Include="Socha3.WebView2Runtime.Evergreen" Condition="'$(SochaPrereqWebView2)' != 'false'">
      <Install>true</Install>
      <ProductName>Microsoft Edge WebView2 Runtime (Evergreen)</ProductName>
    </BootstrapperPackage>
  </ItemGroup>
</Project>
