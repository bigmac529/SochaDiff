<?xml version="1.0" encoding="utf-8"?>
<!-- Self-contained folder publish used as the payload of the MSIX package (Microsoft Store and
     sideload builds). Not used by ClickOnce, which stays framework-dependent (ClickOnce.pubxml).
       pwsh desktop/msix/build-msix.ps1      (runs prepare-bundle -IncludeNode, this publish, makepri, makeappx)
     Self-contained because the Store has no .NET 10 Desktop Runtime framework package to depend on:
     the .NET runtime (~139 MB uncompressed) ships inside the package. node.exe comes from the bundle. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>bin\publish\msix\</PublishDir>
  </PropertyGroup>
</Project>
