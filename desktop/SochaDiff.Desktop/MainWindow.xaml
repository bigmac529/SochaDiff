<Window x:Class="SochaDiff.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Socha Diff"
        Width="1400" Height="900" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid>
    <!-- Hidden (not Collapsed) so its HWND exists and it can initialize while the loading panel shows.
         WebView2 is an HWND, so the overlays below only show while it is hidden (WPF airspace). -->
    <wv2:WebView2 x:Name="WebView" Visibility="Hidden" DefaultBackgroundColor="#10151D" />

    <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
      <TextBlock Text="Socha Diff" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                 HorizontalAlignment="Center" />
      <TextBlock x:Name="LoadingText" Text="Starting..." Margin="0,10,0,14" FontSize="13"
                 Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
      <ProgressBar IsIndeterminate="True" Height="3" BorderThickness="0"
                   Background="{StaticResource PanelBrush}" Foreground="{StaticResource AccentBrush}" />
    </StackPanel>

    <Border x:Name="ErrorPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"
            MaxWidth="720" Margin="24" Padding="24" CornerRadius="8"
            Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#x2716;" FontSize="18" Foreground="{StaticResource ErrorBrush}" Margin="0,0,10,0"
                     VerticalAlignment="Center" />
          <TextBlock x:Name="ErrorTitle" Text="Socha Diff could not start" FontSize="18" FontWeight="SemiBold"
                     Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBox x:Name="ErrorMessage" Margin="0,14,0,0" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                 Background="Transparent" Foreground="{StaticResource TextBrush}" FontSize="13"
                 MaxHeight="320" VerticalScrollBarVisibility="Auto" />
        <TextBlock x:Name="ErrorLogLine" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                   Foreground="{StaticResource MutedBrush}" />
        <WrapPanel Margin="0,18,0,0">
          <Button x:Name="DownloadRuntimeButton" Content="Get WebView2 Runtime" Visibility="Collapsed"
                  Style="{StaticResource HostButton}" Click="DownloadRuntime_Click" />
          <Button x:Name="RetryButton" Content="Retry" Style="{StaticResource HostButton}" Click="Retry_Click" />
          <Button x:Name="OpenLogButton" Content="Open log" Style="{StaticResource HostButton}" Click="OpenLog_Click" />
          <Button x:Name="OpenLogFolderButton" Content="Open log folder" Style="{StaticResource HostButton}"
                  Click="OpenLogFolder_Click" />
          <Button x:Name="PrerequisitesButton" Content="All prerequisites" Visibility="Collapsed"
                  Style="{StaticResource HostButton}" Click="Prerequisites_Click" />
          <Button Content="Close" Style="{StaticResource HostButton}" Click="Close_Click" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
